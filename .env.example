# Researcher login password (default: researcher)
RESEARCHER_PASSWORD=researcher

# Secret key for session signing (auto-generated if not set)
# SECRET_KEY=your-random-secret-key-here

# Live UVA Kimi K2.5 is ON.
# Primary key location (git-ignored, recommended): app/uva_secrets.py -> UVARC_GENAI_API
# Paste your Rivanna key there. Fallbacks: UVARC_GenAI_API env, or UI API-key box.
# UVARC_GenAI_API=
# Optional override; default is UVA RC GenAI
# KIMI_BASE_URL=https://open-webui.rc.virginia.edu/api
# KIMI_MODEL=Kimi K2.5
