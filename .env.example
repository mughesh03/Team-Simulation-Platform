# Researcher login password (default: researcher)
RESEARCHER_PASSWORD=researcher

# Secret key for session signing (auto-generated if not set)
# SECRET_KEY=your-random-secret-key-here

# UVA RC GenAI (ITS) — required for Kimi K2.5
# Get the key from https://open-webui.rc.virginia.edu → Profile → Settings → Account → API Keys
# Off Grounds: connect to UVA Anywhere VPN first
UVARC_GenAI_API=
# Optional override; default is UVA RC GenAI
# KIMI_BASE_URL=https://open-webui.rc.virginia.edu/api
# KIMI_MODEL=Kimi K2.5
